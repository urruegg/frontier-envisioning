{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent identity (frontier-agent-identity/1.0)",
  "type": "object",
  "required": ["schema", "version", "date", "customer", "naming", "environments", "poAreas", "agents"],
  "properties": {
    "schema": {"const": "frontier-agent-identity/1.0"},
    "version": {"type": "string"},
    "date": {"type": "string"},
    "status": {"type": "string"},
    "customer": {"type": "object", "required": ["name", "short"]},
    "naming": {
      "type": "object",
      "required": ["displayTemplate", "maxDisplayLength", "publisherPrefix", "solutionPrefix", "solutionDisplayPrefix", "fullNamePrefix", "allowedDisplayCharacters"],
      "properties": {
        "displayTemplate": {"type": "string"},
        "maxDisplayLength": {"type": "integer", "maximum": 30},
        "publisherPrefix": {"type": "string", "pattern": "^[a-z][a-z0-9]{1,7}$"},
        "allowedPrefixes": {"type": "array", "items": {"type": "string"}},
        "stripLeadingFromStem": {"type": "array", "items": {"type": "string"}}
      }
    },
    "environments": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["name"],
                "properties": {"name": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}$"}, "postfix": {"type": "string"},
                               "shortPrefix": {"type": "string"}, "fullBanner": {"type": "string"}, "production": {"type": "boolean"}}}
    },
    "poAreas": {
      "type": "array",
      "items": {"type": "object", "required": ["token", "code", "processOwner"],
                "properties": {"token": {"type": "string"}, "code": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"},
                               "journeys": {"type": "array", "items": {"type": "string"}}, "assumed": {"type": "boolean"}}}
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "journey", "po", "domain", "kind", "glyph", "shortDescription", "fullDescription"],
        "properties": {
          "id": {"type": "string"},
          "journey": {"type": "string"},
          "role": {"enum": ["orchestrator", "specialist", "data"]},
          "po": {"type": "string"},
          "domain": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9 '\\-]*$"},
          "scope": {"type": "string", "pattern": "^([A-Z]{2})?$"},
          "kind": {"enum": ["copilot-studio", "ess", "declarative-agent", "foundry-agent", "fabric-data-agent", "repository-agent"]},
          "glyph": {"type": "string"},
          "statusClass": {"enum": ["mvp", "validated", "adjusted", "hypothesis", "later", "deferred", "out-of-scope", "repository", "data"]},
          "shortDescription": {"type": "string", "maxLength": 72},
          "fullDescription": {"type": "string", "maxLength": 3900},
          "overrides": {"type": "object"},
          "derived": {"type": "object", "description": "Generated by scripts/build_identity_assets.py - do not edit"}
        }
      }
    }
  }
}
