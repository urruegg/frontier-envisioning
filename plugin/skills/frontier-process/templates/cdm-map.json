{
 "schema": "frontier-cdm-map/1.0",
 "checked": "2026-11-11",
 "note": "The Microsoft standard entity behind each pattern entity type: Common Data Model entities (the Dataverse tables of Dynamics 365 and Power Platform), Dataverse tables of Dynamics 365 apps that extend them, and the finance and operations tables published in the Common Data Model (operationsCommon). Column names are the Dataverse logical names, as they appear in the lakehouse that Link to Fabric creates; finance and operations tables keep their field names. The silver layer conforms other systems (for example SAP) to the same entities and columns. Verify each attribute with the table definition browser of the customer's environment before binding; entries marked checked=false are still to verify.",
 "standards": {
  "cdm": {
   "label": "Common Data Model",
   "what": "Standard entity of the Common Data Model, a Dataverse table"
  },
  "dataverse": {
   "label": "Dataverse (Dynamics 365)",
   "what": "Dataverse table of a Dynamics 365 app that extends the Common Data Model foundation"
  },
  "operations": {
   "label": "Common Data Model (finance and operations)",
   "what": "Finance and operations table published in the Common Data Model (operationsCommon)"
  },
  "custom": {
   "label": "Custom extension",
   "what": "No standard entity: a custom table that follows the Common Data Model conventions"
  }
 },
 "match": {
  "exact": "The same business concept",
  "extends": "Specialises the standard entity (a subset or a subtype)",
  "related": "The closest standard entity; the silver layer maps and completes it",
  "custom": "No standard entity"
 },
 "roles": {
  "fact": "Events and transactions: fact tables in the gold star schema",
  "dimension": "Business entities to filter and group by: dimension tables"
 },
