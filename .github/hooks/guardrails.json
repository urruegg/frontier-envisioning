{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/scripts/session_start.py",
        "powershell": "python .github/hooks/scripts/session_start.py",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/scripts/guard.py",
        "powershell": "python .github/hooks/scripts/guard.py",
        "cwd": ".",
        "timeoutSec": 15
      }
    ]
  }
}
