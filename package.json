  "version": "0.0.0",
  "description": "Test tooling for the Frontier Envisioning plugin: DOM tests (happy-dom), browser tests (Playwright), renderer lint (ESLint)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:dom": "node --test tests/dom/blueprint.test.mjs tests/dom/identity-value.test.mjs",
    "test:e2e": "playwright test",
    "lint:js": "eslint src/renderer tests/dom tests/e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.50.0",
    "axe-core": "4.11.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.11.0"
  }
}
